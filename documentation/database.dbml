Project baseJudge {
  database_type: 'PostgreSQL'
  Note: '''20 application tables, 144 columns; migrations 000001 through 000013.
SQL migrations are authoritative. Identity columns use GENERATED ALWAYS AS IDENTITY.
Partial indexes are documented in notes because the DBML converter omits predicates.
Schema structure does not implement authorization, version immutability, worker fencing, or judging transactions.
No credentials, hidden tests, submission contents, or production data are included.'''
}

Table "users" {
  Note: 'Accounts: role_id 1 admin, 2 guest (default). Registration must prevent role escalation in application code.'
  "id" bigint [pk, increment]
  "username" text [not null]
  "display_name" text [not null]
  "email" text [not null]
  "email_verified_at" timestamptz
  "password_hash" text
  "google_subject" text
  "role_id" smallint [not null, default: 2]
  "disabled_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `username ~ '^[a-z0-9_]{3,32}$'` [name: 'users_username_check']
    `char_length(btrim(display_name)) BETWEEN 1 AND 100` [name: 'users_display_name_check']
    `email <> '' AND email = lower(btrim(email))` [name: 'users_email_check']
    `role_id IN (1, 2)` [name: 'users_role_check']
    `password_hash IS NULL OR btrim(password_hash) <> ''` [name: 'users_password_hash_check']
    `google_subject IS NULL OR btrim(google_subject) <> ''` [name: 'users_google_subject_check']
    `disabled_at IS NOT NULL
        OR password_hash IS NOT NULL
        OR google_subject IS NOT NULL` [name: 'users_credentials_check']
  }

  Indexes {
    username [unique, name: "users_username_key"]
    email [unique, name: "users_email_key"]
    google_subject [unique, name: "users_google_subject_key"]
  }
}

Table "user_sessions" {
  Note: 'Hashed opaque sessions. Application checks current account state, expiry and revocation. Disposable on approved account deletion.'
  "id" bigint [pk, increment]
  "user_id" bigint [not null]
  "token_hash" bytea [unique, not null]
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "revoked_at" timestamptz

  Checks {
    `octet_length(token_hash) = 32` [name: 'user_sessions_token_hash_check']
    `expires_at > created_at` [name: 'user_sessions_expiry_check']
    `revoked_at >= created_at` [name: 'user_sessions_revocation_check']
  }

  Indexes {
    user_id [name: "user_sessions_user_idx"]
    expires_at [name: "user_sessions_expiry_idx"]
  }
}

Table "account_tokens" {
  Note: 'Single-use hashed verification/reset tokens. Transactionally check expiry, target email and consumption.'
  "id" bigint [pk, increment]
  "user_id" bigint [not null]
  "token_hash" bytea [unique, not null]
  "purpose" text [not null]
  "target_email" text
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "consumed_at" timestamptz

  Checks {
    `octet_length(token_hash) = 32` [name: 'account_tokens_token_hash_check']
    `purpose IN ('email_verification', 'password_reset')` [name: 'account_tokens_purpose_check']
    `(purpose = 'email_verification' AND target_email IS NOT NULL
         AND target_email <> '' AND target_email = lower(btrim(target_email)))
        OR (purpose = 'password_reset' AND target_email IS NULL)` [name: 'account_tokens_target_email_check']
    `expires_at > created_at` [name: 'account_tokens_expiry_check']
    `consumed_at >= created_at` [name: 'account_tokens_consumption_check']
  }

  Indexes {
    user_id [name: "account_tokens_user_idx"]
    expires_at [name: "account_tokens_expiry_idx"]
  }
}

Table "stored_files" {
  Note: 'Private immutable files identified by opaque keys and SHA-256. Storage code validates safe keys and byte contents; references restrict deletion.'
  "id" bigint [pk, increment]
  "storage_key" text [unique, not null]
  "sha256" bytea [not null]
  "size_bytes" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `btrim(storage_key) <> ''` [name: 'stored_files_key_check']
    `octet_length(sha256) = 32` [name: 'stored_files_hash_check']
    `size_bytes >= 0` [name: 'stored_files_size_check']
  }
}

Table "problems" {
  Note: 'Publication: 1 draft, 2 published, 3 archived. Difficulty: 1 easy, 2 medium, 3 hard. Current version must belong to this problem.'
  "id" bigint [pk, increment]
  "created_by" bigint [not null]
  "publication_status_id" smallint [not null, default: 1]
  "difficulty_id" smallint
  "current_version_id" bigint
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `publication_status_id IN (1, 2, 3)` [name: 'problems_publication_status_check']
    `difficulty_id IN (1, 2, 3)` [name: 'problems_difficulty_check']
    `publication_status_id <> 2 OR (current_version_id IS NOT NULL AND difficulty_id IS NOT NULL)` [name: 'problems_published_check']
  }

  Indexes {
    (publication_status_id, id) [name: "problems_publication_idx"]
    created_by [name: "problems_creator_idx"]
    (id, current_version_id) [name: "problems_current_version_idx"]
  }
}

Table "problem_versions" {
  Note: 'Versioned content, limits and checker. Draft limits may be NULL. Publication/use validates completeness; application prevents changes after exposure or use.'
  "id" bigint [pk, increment]
  "problem_id" bigint [not null]
  "version_number" integer [not null]
  "title" text [not null]
  "statement" text [not null, default: '']
  "time_limit_ms" integer
  "memory_limit_bytes" bigint
  "output_limit_bytes" bigint
  "checker_key" text [not null, default: 'token']
  "checker_version" text [not null]
  "created_by" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `version_number > 0` [name: 'problem_versions_number_check']
    `btrim(title) <> ''` [name: 'problem_versions_title_check']
    `time_limit_ms > 0` [name: 'problem_versions_time_check']
    `memory_limit_bytes > 0` [name: 'problem_versions_memory_check']
    `output_limit_bytes > 0` [name: 'problem_versions_output_check']
    `btrim(checker_key) <> ''` [name: 'problem_versions_checker_key_check']
    `btrim(checker_version) <> ''` [name: 'problem_versions_checker_version_check']
  }

  Indexes {
    (problem_id, version_number) [unique]
    (problem_id, id) [unique]
    created_by [name: "problem_versions_creator_idx"]
  }
}

Table "tags" {
  Note: 'Editable classification labels, stored trimmed and lowercase.'
  "id" bigint [pk, increment]
  "name" text [unique, not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `name <> '' AND name = lower(btrim(name))` [name: 'tags_name_check']
  }
}

Table "problem_tags" {
  Note: 'Disposable many-to-many tag associations; deleting an association does not delete judging history.'
  "problem_id" bigint [not null]
  "tag_id" bigint [not null]

  Indexes {
    (problem_id, tag_id) [pk]
    (tag_id, problem_id) [name: "problem_tags_tag_idx"]
  }
}

Table "problem_editorials" {
  Note: 'Optional editorial per version. Publication: 1 draft, 2 published, 3 archived. Live-contest access restrictions remain application checks.'
  "problem_version_id" bigint [pk]
  "body" text [not null]
  "publication_status_id" smallint [not null, default: 1]
  "created_by" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `btrim(body) <> ''` [name: 'problem_editorials_body_check']
    `publication_status_id IN (1, 2, 3)` [name: 'problem_editorials_publication_status_check']
  }

  Indexes {
    created_by [name: "problem_editorials_creator_idx"]
  }
}

Table "problem_test_cases" {
  Note: 'Ordered sample and hidden tests reference private stored files. Application prevents editing tests of exposed/used versions.'
  "id" bigint [pk, increment]
  "problem_version_id" bigint [not null]
  "position" integer [not null]
  "is_sample" boolean [not null, default: false]
  "input_file_id" bigint [not null]
  "expected_output_file_id" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `position > 0` [name: 'problem_test_cases_position_check']
  }

  Indexes {
    (problem_version_id, position) [unique]
    (problem_version_id, id) [unique]
    input_file_id [name: "problem_test_cases_input_idx"]
    expected_output_file_id [name: "problem_test_cases_output_idx"]
  }
}

Table "contests" {
  Note: 'Individual ICPC contests. Publication: 1 draft, 2 published, 3 archived. Phase is derived from start/end; no stored phase. Default penalty is 20 minutes.'
  "id" bigint [pk, increment]
  "created_by" bigint [not null]
  "title" text [not null]
  "description" text [not null, default: '']
  "publication_status_id" smallint [not null, default: 1]
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "entry_password_hash" text
  "penalty_minutes" integer [not null, default: 20]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `btrim(title) <> ''` [name: 'contests_title_check']
    `publication_status_id IN (1, 2, 3)` [name: 'contests_publication_status_check']
    `starts_at < ends_at` [name: 'contests_schedule_check']
    `btrim(entry_password_hash) <> ''` [name: 'contests_password_check']
    `penalty_minutes >= 0` [name: 'contests_penalty_check']
  }

  Indexes {
    (publication_status_id, starts_at, id) [name: "contests_publication_idx"]
    created_by [name: "contests_creator_idx"]
  }
}

Table "contest_problems" {
  Note: 'Contest lineup pins owned problem versions, unique labels and ordering. Referenced entries cannot be deleted.'
  "contest_id" bigint [not null]
  "problem_id" bigint [not null]
  "problem_version_id" bigint [not null]
  "label" text [not null]
  "position" integer [not null]

  Checks {
    `btrim(label) <> ''` [name: 'contest_problems_label_check']
    `position > 0` [name: 'contest_problems_position_check']
  }

  Indexes {
    (contest_id, problem_id) [pk]
    (contest_id, label) [unique]
    (contest_id, position) [unique]
    (problem_id, contest_id) [name: "contest_problems_problem_idx"]
    (problem_id, problem_version_id) [name: "contest_problems_version_idx"]
  }
}

Table "contest_registrations" {
  Note: 'Retained entry history. Application checks timing, account eligibility, creator exclusion and privileged-access conflicts under a contest lock.'
  "contest_id" bigint [not null]
  "user_id" bigint [not null]
  "registered_at" timestamptz [not null]

  Indexes {
    (contest_id, user_id) [pk]
    (user_id, contest_id) [name: "contest_registrations_user_idx"]
  }
}

Table "contest_privileged_users" {
  Note: 'Retained exposure marker. Does not itself grant admin privileges. Application prevents conflicting competitive entry before/during contests.'
  "contest_id" bigint [not null]
  "user_id" bigint [not null]
  "granted_at" timestamptz [not null]

  Indexes {
    (contest_id, user_id) [pk]
    (user_id, contest_id) [name: "contest_privileged_users_user_idx"]
  }
}

Table "judge_runtimes" {
  Note: 'C++ only. Exact compiler and environment identity are required when adding a runtime. No runtime is seeded; used configurations must be immutable.'
  "id" bigint [pk, increment]
  "key" text [unique, not null]
  "language_key" text [not null, default: 'cpp']
  "compiler_version" text [not null]
  "compile_flags" "text[]" [not null, default: '{}']
  "environment_digest" text [not null]
  "enabled" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `btrim(key) <> ''` [name: 'judge_runtimes_key_check']
    `language_key = 'cpp'` [name: 'judge_runtimes_language_check']
    `btrim(compiler_version) <> ''` [name: 'judge_runtimes_compiler_check']
    `btrim(environment_digest) <> ''` [name: 'judge_runtimes_environment_check']
    `cardinality(compile_flags) = 0
        OR (array_ndims(compile_flags) = 1 AND array_position(compile_flags, NULL) IS NULL)` [name: 'judge_runtimes_flags_check']
  }
}

Table "submissions" {
  Note: 'Source capped at 262144 UTF-8 bytes. Submitted version and effective judging have ownership FKs. Contest source visibility is application policy.'
  "id" bigint [pk, increment]
  "user_id" bigint [not null]
  "problem_id" bigint [not null]
  "submitted_problem_version_id" bigint [not null]
  "contest_id" bigint
  "is_competitive" boolean [not null, default: false]
  "source_code" text [not null]
  "requested_runtime_id" bigint [not null]
  "submitted_at" timestamptz [not null]
  "effective_judging_id" bigint

  Checks {
    `NOT is_competitive OR contest_id IS NOT NULL` [name: 'submissions_competitive_check']
    `btrim(source_code) <> '' AND octet_length(source_code) <= 262144` [name: 'submissions_source_check']
  }

  Indexes {
    (id, problem_id) [unique]
    (user_id, submitted_at, id) [name: "submissions_user_idx"]
    (problem_id, submitted_at, id) [name: "submissions_problem_idx"]
    (contest_id, problem_id) [name: "submissions_contest_idx"]
    requested_runtime_id [name: "submissions_runtime_idx"]
    (problem_id, submitted_problem_version_id) [name: "submissions_version_idx"]
    (id, effective_judging_id) [name: "submissions_effective_idx"]
    (contest_id, user_id, problem_id, submitted_at, id) [name: "submissions_competition_idx", note: 'Partial index: WHERE is_competitive']
  }
}

Table "rejudge_batches" {
  Note: 'States: 1 running, 2 ready, 3 applied, 4 cancelled. Apply/cancel and baseline conflict checks require guarded transactions.'
  "id" bigint [pk, increment]
  "requested_by" bigint [not null]
  "reason" text [not null]
  "state_id" smallint [not null, default: 1]
  "created_at" timestamptz [not null, default: `now()`]
  "decided_at" timestamptz
  "decided_by" bigint

  Checks {
    `btrim(reason) <> ''` [name: 'rejudge_batches_reason_check']
    `state_id IN (1, 2, 3, 4)` [name: 'rejudge_batches_state_check']
    `(state_id IN (1, 2) AND decided_at IS NULL AND decided_by IS NULL)
        OR (state_id IN (3, 4) AND decided_at IS NOT NULL AND decided_by IS NOT NULL)` [name: 'rejudge_batches_decision_check']
    `decided_at >= created_at` [name: 'rejudge_batches_time_check']
  }

  Indexes {
    (state_id, created_at, id) [name: "rejudge_batches_state_idx"]
    requested_by [name: "rejudge_batches_requester_idx"]
    decided_by [name: "rejudge_batches_decider_idx"]
  }
}

Table "judgings" {
  Note: '''Statuses: 1 queued, 2 running, 3 finished, 4 failed.
Verdicts: 1 accepted, 2 wrong_answer, 3 time_limit_exceeded, 4 memory_limit_exceeded, 5 runtime_error, 6 compilation_error.
Infrastructure errors are capped at 8192 UTF-8 bytes. Output-limit verdict 7 is not implemented.
judgings_one_active_idx is UNIQUE ONLY WHERE status_id IN (1, 2); historical attempts may share submission_id.
Lifecycle row shapes are checked by SQL. Lease ownership, allowed transitions and result completeness require application transactions.'''
  "id" bigint [pk, increment]
  "submission_id" bigint [not null]
  "attempt_number" integer [not null]
  "problem_id" bigint [not null]
  "problem_version_id" bigint [not null]
  "runtime_id" bigint [not null]
  "rejudge_batch_id" bigint
  "status_id" smallint [not null, default: 1]
  "verdict_id" smallint
  "queued_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz
  "finished_at" timestamptz
  "worker_key" text
  "lease_token" uuid
  "lease_expires_at" timestamptz
  "compile_log_file_id" bigint
  "infrastructure_error" text

  Checks {
    `attempt_number > 0` [name: 'judgings_attempt_check']
    `status_id IN (1, 2, 3, 4)` [name: 'judgings_status_check']
    `verdict_id IN (1, 2, 3, 4, 5, 6)` [name: 'judgings_verdict_check']
    `btrim(worker_key) <> ''` [name: 'judgings_worker_check']
    `btrim(infrastructure_error) <> '' AND octet_length(infrastructure_error) <= 8192` [name: 'judgings_error_check']
    `started_at IS NULL OR (worker_key IS NOT NULL AND started_at >= queued_at)` [name: 'judgings_start_check']
    `finished_at >= queued_at AND finished_at >= started_at` [name: 'judgings_finish_check']
    `lease_expires_at > started_at` [name: 'judgings_lease_check']
    `(status_id = 1 AND verdict_id IS NULL AND started_at IS NULL AND finished_at IS NULL
         AND worker_key IS NULL AND lease_token IS NULL AND lease_expires_at IS NULL AND infrastructure_error IS NULL)
        OR (status_id = 2 AND started_at IS NOT NULL AND worker_key IS NOT NULL
         AND lease_token IS NOT NULL AND lease_expires_at IS NOT NULL AND verdict_id IS NULL
         AND finished_at IS NULL AND infrastructure_error IS NULL)
        OR (status_id = 3 AND started_at IS NOT NULL AND finished_at IS NOT NULL AND verdict_id IS NOT NULL
         AND worker_key IS NOT NULL AND lease_token IS NULL AND lease_expires_at IS NULL AND infrastructure_error IS NULL)
        OR (status_id = 4 AND finished_at IS NOT NULL AND infrastructure_error IS NOT NULL
         AND verdict_id IS NULL AND lease_token IS NULL AND lease_expires_at IS NULL)` [name: 'judgings_lifecycle_check']
  }

  Indexes {
    (submission_id, attempt_number) [unique]
    (submission_id, id) [unique]
    (id, problem_version_id) [unique]
    (rejudge_batch_id, submission_id, id) [unique]
    submission_id [name: "judgings_one_active_idx", note: 'UNIQUE partial index: WHERE status_id IN (1, 2). Not globally unique.']
    (queued_at, id) [name: "judgings_queue_idx", note: 'Partial index: WHERE status_id = 1']
    lease_expires_at [name: "judgings_expiry_idx", note: 'Partial index: WHERE status_id = 2']
    (problem_id, problem_version_id) [name: "judgings_version_idx"]
    runtime_id [name: "judgings_runtime_idx"]
    compile_log_file_id [name: "judgings_compile_log_idx"]
    (submission_id, problem_id) [name: "judgings_submission_idx"]
  }
}

Table "judging_test_results" {
  Note: 'Version-matched per-test results. Verdict IDs 1-5 only; compilation failures have no per-test result. NULL measurements mean unavailable.'
  "judging_id" bigint [not null]
  "test_case_id" bigint [not null]
  "problem_version_id" bigint [not null]
  "verdict_id" smallint [not null]
  "runtime_ms" bigint
  "memory_bytes" bigint
  "output_file_id" bigint
  "diagnostic_file_id" bigint
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `verdict_id IN (1, 2, 3, 4, 5)` [name: 'judging_test_results_verdict_check']
    `runtime_ms >= 0` [name: 'judging_test_results_runtime_check']
    `memory_bytes >= 0` [name: 'judging_test_results_memory_check']
  }

  Indexes {
    (judging_id, test_case_id) [pk]
    (problem_version_id, test_case_id) [name: "judging_test_results_test_idx"]
    (judging_id, problem_version_id) [name: "judging_test_results_judging_idx"]
    output_file_id [name: "judging_test_results_output_idx"]
    diagnostic_file_id [name: "judging_test_results_diagnostic_idx"]
  }
}

Table "rejudge_items" {
  Note: 'Baseline belongs to the submission; candidate belongs to both the batch and submission. NULL means not selected yet. Applying a batch must switch results atomically.'
  "batch_id" bigint [not null]
  "submission_id" bigint [not null]
  "baseline_judging_id" bigint
  "candidate_judging_id" bigint

  Indexes {
    (batch_id, submission_id) [pk]
    (submission_id, baseline_judging_id) [name: "rejudge_items_baseline_idx"]
    (batch_id, submission_id, candidate_judging_id) [name: "rejudge_items_candidate_idx"]
  }
}

Ref:"users"."id" <? "user_sessions"."user_id" [delete: cascade]

Ref:"users"."id" <? "account_tokens"."user_id" [delete: cascade]

Ref:"users"."id" <? "problems"."created_by" [delete: restrict]

Ref:"problems"."id" <? "problem_versions"."problem_id" [delete: restrict]

Ref:"users"."id" <? "problem_versions"."created_by" [delete: restrict]

Ref "problems_current_version_fk":"problem_versions".("problem_id", "id") ?<? "problems".("id", "current_version_id") [delete: restrict]

Ref:"problems"."id" <? "problem_tags"."problem_id" [delete: cascade]

Ref:"tags"."id" <? "problem_tags"."tag_id" [delete: cascade]

Ref:"problem_versions"."id" <? "problem_editorials"."problem_version_id" [delete: restrict]

Ref:"users"."id" <? "problem_editorials"."created_by" [delete: restrict]

Ref:"problem_versions"."id" <? "problem_test_cases"."problem_version_id" [delete: restrict]

Ref:"stored_files"."id" <? "problem_test_cases"."input_file_id" [delete: restrict]

Ref:"stored_files"."id" <? "problem_test_cases"."expected_output_file_id" [delete: restrict]

Ref:"users"."id" <? "contests"."created_by" [delete: restrict]

Ref:"contests"."id" <? "contest_problems"."contest_id" [delete: restrict]

Ref:"problems"."id" <? "contest_problems"."problem_id" [delete: restrict]

Ref "contest_problems_version_fk":"problem_versions".("problem_id", "id") <? "contest_problems".("problem_id", "problem_version_id") [delete: restrict]

Ref:"contests"."id" <? "contest_registrations"."contest_id" [delete: restrict]

Ref:"users"."id" <? "contest_registrations"."user_id" [delete: restrict]

Ref:"contests"."id" <? "contest_privileged_users"."contest_id" [delete: restrict]

Ref:"users"."id" <? "contest_privileged_users"."user_id" [delete: restrict]

Ref:"users"."id" <? "submissions"."user_id" [delete: restrict]

Ref:"problems"."id" <? "submissions"."problem_id" [delete: restrict]

Ref:"judge_runtimes"."id" <? "submissions"."requested_runtime_id" [delete: restrict]

Ref "submissions_version_fk":"problem_versions".("problem_id", "id") <? "submissions".("problem_id", "submitted_problem_version_id") [delete: restrict]

Ref "submissions_contest_problem_fk":"contest_problems".("contest_id", "problem_id") ?<? "submissions".("contest_id", "problem_id") [delete: restrict]

Ref:"users"."id" <? "rejudge_batches"."requested_by" [delete: restrict]

Ref:"users"."id" ?<? "rejudge_batches"."decided_by" [delete: restrict]

Ref:"judge_runtimes"."id" <? "judgings"."runtime_id" [delete: restrict]

Ref:"rejudge_batches"."id" ?<? "judgings"."rejudge_batch_id" [delete: restrict]

Ref:"stored_files"."id" ?<? "judgings"."compile_log_file_id" [delete: restrict]

Ref "judgings_submission_fk":"submissions".("id", "problem_id") <? "judgings".("submission_id", "problem_id") [delete: restrict]

